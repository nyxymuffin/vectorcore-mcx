<!-- MCPTT third-party REGISTER from S-CSCF -->
<InitialFilterCriteria>
    <Priority>25</Priority>
    <TriggerPoint>
        <ConditionTypeCNF>1</ConditionTypeCNF>

        <SPT>
            <ConditionNegated>0</ConditionNegated>
            <Group>0</Group>
            <Method>REGISTER</Method>
            <Extension></Extension>
        </SPT>

        <SPT>
            <ConditionNegated>0</ConditionNegated>
            <Group>0</Group>
            <SIPHeader>
                <Header>Contact</Header>
                <Content>+g.3gpp.mcptt</Content>
            </SIPHeader>
        </SPT>
    </TriggerPoint>

    <ApplicationServer>
        <ServerName>sip:mcptt-as.ims.mnc435.mcc311.3gppnetwork.org:5060</ServerName>
        <DefaultHandling>0</DefaultHandling>
        <ServiceInfo>MCPTT-REGISTER</ServiceInfo>
        <Extension>
            <IncludeRegisterRequest/>
            <IncludeRegisterResponse/>
        </Extension>
    </ApplicationServer>
</InitialFilterCriteria>

